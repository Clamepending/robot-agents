FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml README.md /app/
COPY src /app/src

RUN pip install --no-cache-dir . fastapi uvicorn

EXPOSE 8080
CMD ["uvicorn", "robot_policy_mcp.mock_robot_api:app", "--host", "0.0.0.0", "--port", "8080"]
